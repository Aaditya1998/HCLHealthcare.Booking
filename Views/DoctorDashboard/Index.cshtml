@model IEnumerable<HCLHealthcare.Booking.Models.Appointment>

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👨‍⚕️ Welcome, @ViewBag.DoctorName</h2>
        <a asp-action="ManageSlots" class="btn btn-primary"><i class="bi bi-calendar-week"></i> Manage Schedule</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Upcoming Appointments</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Time</th>
                            <th>Patient Name</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No upcoming appointments found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.AppointmentDate.Date == DateTime.Today ? "table-info" : "")">
                                    <td>
                                        <strong>@item.AppointmentDate.ToString("MMM dd")</strong><br />
                                        @item.AppointmentDate.ToString("hh:mm tt")
                                    </td>
                                    <td>@item.Patient?.FullName <br /><small class="text-muted">@item.Patient?.Email</small></td>
                                    <td><span class="badge bg-secondary">@item.AppointmentType</span></td>
                                    <td>
                                        <span class="badge @(item.Status == "Booked" ? "bg-warning text-dark" : item.Status == "Completed" ? "bg-success" : "bg-danger")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.Status == "Booked")
                                        {
                                            <form asp-action="MarkCompleted" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-circle"></i> Complete
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
