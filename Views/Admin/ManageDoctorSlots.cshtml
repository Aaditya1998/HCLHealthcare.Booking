@model IEnumerable<HCLHealthcare.Booking.Models.TimeSlot>

@{
    ViewData["Title"] = "Manage Slots - " + ViewBag.DoctorName;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="ManageDoctors">Doctors</a></li>
            <li class="breadcrumb-item active" aria-current="page">Manage Slots</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Schedule: @ViewBag.DoctorName</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#generateModal">
            <i class="bi bi-magic"></i> Bulk Generate Slots
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <p class="text-muted text-center py-5">No upcoming slots found.</p>
            }
            else
            {
                var groupedSlots = Model.GroupBy(s => s.StartTime.Date).OrderBy(g => g.Key);
                
                <div class="accordion" id="slotsAccordion">
                    @foreach (var group in groupedSlots)
                    {
                        var dateId = "date-" + group.Key.ToString("yyyyMMdd");
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading-@dateId">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@dateId">
                                    @group.Key.ToString("dddd, MMMM dd, yyyy") 
                                    <span class="badge bg-secondary ms-2">@group.Count() slots</span>
                                </button>
                            </h2>
                            <div id="@dateId" class="accordion-collapse collapse" data-bs-parent="#slotsAccordion">
                                <div class="accordion-body">
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var slot in group)
                                        {
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-outline-primary" disabled>
                                                    @slot.StartTime.ToString("hh:mm tt") - @slot.EndTime.ToString("hh:mm tt")
                                                </button>
                                                @if (slot.IsAvailable)
                                                {
                                                    <form asp-action="DeleteSlot" asp-route-id="@slot.Id" asp-route-doctorId="@ViewBag.DoctorId" method="post" onsubmit="return confirm('Delete this slot?');">
                                                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-secondary" title="Booked" disabled><i class="bi bi-lock-fill"></i></button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Bulk Generate Modal -->
<div class="modal fade" id="generateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="GenerateSlots" method="post">
                <input type="hidden" name="doctorId" value="@ViewBag.DoctorId" />
                <div class="modal-header">
                    <h5 class="modal-title">Bulk Generate Slots</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Start Date</label>
                            <input type="date" name="startDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col">
                            <label class="form-label">End Date</label>
                            <input type="date" name="endDate" class="form-control" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Start Time</label>
                            <input type="time" name="startTime" class="form-control" value="09:00" required />
                        </div>
                        <div class="col">
                            <label class="form-label">End Time</label>
                            <input type="time" name="endTime" class="form-control" value="17:00" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Interval (Minutes)</label>
                        <select name="interval" class="form-select">
                            <option value="15">15 Minutes</option>
                            <option value="30" selected>30 Minutes</option>
                            <option value="45">45 Minutes</option>
                            <option value="60">60 Minutes</option>
                        </select>
                    </div>
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle"></i> Existing slots will not be duplicated. Overlapping slots will be skipped.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Generate</button>
                </div>
            </form>
        </div>
    </div>
</div>
