@model IEnumerable<HCLHealthcare.Booking.Models.Doctor>

@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Doctors</h2>
        <a asp-action="CreateDoctor" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add New Doctor</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Specialization</th>
                <th>Center</th>
                <th>Experience</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.User?.FullName</td>
                    <td>@item.Specialization?.Name</td>
                    <td>@item.Center?.Name, @item.Center?.Location</td>
                    <td>@item.Experience years</td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="ManageDoctorSlots" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="Manage Slots"><i class="bi bi-calendar-week"></i></a>
                            <a asp-action="EditDoctor" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="DeleteDoctor" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-link">Back to Dashboard</a>
</div>
