@model IEnumerable<HCLHealthcare.Booking.Models.Center>

@{
    ViewData["Title"] = "Manage Centers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Centers</h2>
        <a asp-action="CreateCenter" class="btn btn-success"><i class="bi bi-plus-lg"></i> Add New Center</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Location</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Location</td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="EditCenter" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="DeleteCenter" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger ms-1">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-link">Back to Dashboard</a>
</div>
