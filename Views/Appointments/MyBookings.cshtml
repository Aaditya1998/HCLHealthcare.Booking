@model IEnumerable<HCLHealthcare.Booking.Models.Appointment>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container mt-4">
    <h2>My Appointments</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive mt-3">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Date & Time</th>
                    <th>Doctor</th>
                    <th>Specialization</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AppointmentDate.ToString("f")</td>
                        <td>@item.Doctor?.User?.FullName</td>
                        <td>@item.Doctor?.Specialization?.Name</td>
                        <td>@item.Doctor?.Center?.Name</td>
                        <td>
                            <span class="badge @(item.Status == "Booked" ? "bg-success" : item.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            @if (item.Status == "Booked" && item.AppointmentDate > DateTime.Now)
                            {
                                <form asp-action="Cancel" method="post" onsubmit="return confirm('Are you sure you want to cancel?');" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                </form>
                                
                                @if (!string.IsNullOrEmpty(item.MeetingLink))
                                {
                                    <a href="@item.MeetingLink" target="_blank" class="btn btn-sm btn-primary ms-1">
                                        <i class="bi bi-camera-video"></i> Join Call
                                    </a>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
